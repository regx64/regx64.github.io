---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title} | regx64</title>
<meta name="description" content={description}>
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="stylesheet" href="/style.css">
<style is:global>
  .notes-doc {
    position: relative;
    z-index: 2;
    max-width: 43rem;
    margin: 0 auto;
    padding: 8rem 1.375rem 6rem;
  }
  .notes-doc h1 { margin: 0 0 1rem; font-size: clamp(2.25rem, 5vw, 3.25rem); font-weight: 700; letter-spacing: -0.045em; line-height: 1.12; }
  .notes-doc .lede { margin: 0 0 1.5rem; color: var(--muted); font-size: clamp(1.1875rem, 1.8vw, 1.3125rem); line-height: 1.5; letter-spacing: -0.02em; }
  .notes-meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 0 0 2.5rem; font-size: 0.875rem; color: var(--muted); font-family: var(--mono); }
  .notes-meta a { color: var(--ink); text-decoration: underline; text-underline-offset: 0.2em; }

  .notes-doc article :is(h2, h3) { margin: 2.25rem 0 0.75rem; letter-spacing: -0.01em; }
  .notes-doc article h2 { font-size: 1.5rem; letter-spacing: -0.03em; margin-top: 3rem; }
  .notes-doc article h3 { font-size: 1.0625rem; }
  .notes-doc article { font-size: 1.0625rem; line-height: 1.8; }
  .notes-doc article p { margin: 0 0 1.25rem; }
  .notes-doc article a { color: var(--link); text-decoration: none; }
  .notes-doc article a:hover { text-decoration: underline; }
  .notes-doc article ul, .notes-doc article ol { margin: 0 0 1.1rem; padding-left: 1.3rem; }
  .notes-doc article li { margin-bottom: 0.4rem; }
  .notes-doc article code {
    font-family: var(--mono);
    font-size: 0.875em;
    background: rgba(0, 0, 0, 0.06);
    padding: 0.1em 0.35em;
    border-radius: 0.3em;
  }
  .notes-doc article pre {
    margin: 1.25rem 0;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    background: #1D1D1F;
    color: #E8E8ED;
    border-radius: 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .notes-doc article pre code { background: none; padding: 0; }

  /* 분해 다이어그램: SYSTEM ↓ SUBSYSTEM ↓ ... 모티프 */
  .flow {
    list-style: none;
    margin: 1.5rem 0;
    padding: 1.25rem 1.4rem;
    background: var(--tone-a);
    border-radius: 1rem;
    font-family: var(--mono);
    font-size: 0.9375rem;
  }
  .flow li { padding: 0.35rem 0; }
  .flow li:not(:last-child)::after { content: "↓"; display: block; color: var(--muted); padding-top: 0.35rem; }

  .callout {
    margin: 1.5rem 0;
    padding: 1rem 1.2rem;
    border-left: 3px solid var(--ink);
    background: var(--tone-a);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .callout p:last-child { margin-bottom: 0; }

  .notes-pager {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    font-size: 0.9375rem;
  }
  .notes-pager a { text-decoration: none; font-weight: 600; }
  .notes-pager a:hover { text-decoration: underline; }

  /* 블로그 */
  .eyebrow-sm { margin: 0 0 0.75rem; font-size: 1.0625rem; font-weight: 600; color: var(--muted); }
  .eyebrow-sm a { color: inherit; text-decoration: none; }
  .eyebrow-sm a:hover { color: var(--link); }
  .notes-doc .lede a { color: var(--link); text-decoration: none; }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 0.5rem; }
  .chip {
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    background: var(--bg-alt);
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--ink);
    transition: background-color 0.2s;
  }
  .chip:hover { background: #E8E8ED; }
  .chip.is-active { background: var(--ink); color: #FFFFFF; }
  .post-hero { margin: 0 0 2rem; }
  .post-hero img { display: block; width: 100%; max-height: 32rem; object-fit: cover; border-radius: 1.25rem; }
  .post-audio { margin: 0 0 2rem; padding: 1.1rem 1.25rem; border-radius: 1.25rem; background: var(--bg-alt); }
  .post-audio figcaption { margin: 0 0 0.6rem; font-size: 0.9375rem; font-weight: 600; color: var(--ink); }
  .post-audio audio, .notes-doc article audio { display: block; width: 100%; }
  .post-video, .notes-doc article .video { position: relative; margin: 0 0 2rem; aspect-ratio: 16 / 9; border-radius: 1.25rem; overflow: hidden; background: #000; }
  .post-video iframe, .notes-doc article .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .notes-doc article img { max-width: 100%; height: auto; border-radius: 1rem; }
  .notes-doc article audio { margin: 1.25rem 0; }
  .post-tags { margin-top: 2.5rem; }

  /* 태그 */
  .tag-row { margin: 0 0 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag {
    font-size: 0.8125rem;
    font-family: var(--mono);
    color: var(--muted);
    text-decoration: none;
    padding: 0.15rem 0.55rem;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 999px;
  }
  .tag:hover { color: var(--ink); border-color: var(--ink); }

  /* 시리즈 */
  .series-box {
    margin: 0 0 2rem;
    padding: 1rem 1.2rem;
    background: var(--tone-a);
    border-radius: 0.75rem;
    font-size: 0.9375rem;
  }
  .series-box-label { margin: 0 0 0.6rem; font-weight: 600; }
  .series-box-label a { text-decoration: underline; text-underline-offset: 0.2em; }
  .series-box-label span { font-weight: 400; color: var(--muted); font-family: var(--mono); }
  .series-box-list { list-style: none; margin: 0; padding: 0; counter-reset: none; }
  .series-box-list li { padding: 0.25rem 0; color: var(--muted); }
  .series-box-list li.current { color: var(--ink); font-weight: 600; }
  .series-box-list a { color: var(--muted); text-decoration: none; }
  .series-box-list a:hover { color: var(--ink); text-decoration: underline; }

  /* 마우스 오버 각주: 본문 중 <span class="fn">트리거<span class="fn-note">각주 내용</span></span> 로 작성 */
  .fn {
    position: relative;
    border-bottom: 1px dotted var(--muted);
    cursor: help;
  }
  .fn-note {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.5rem);
    transform: translateX(-50%);
    width: max-content;
    max-width: min(20rem, 80vw);
    background: var(--ink);
    color: #fff;
    font-size: 0.8125rem;
    line-height: 1.55;
    font-weight: 400;
    padding: 0.6rem 0.8rem;
    border-radius: 0.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s ease;
    z-index: 10;
  }
  .fn-note::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 0.35rem solid transparent;
    border-top-color: var(--ink);
  }
  .fn:hover .fn-note,
  .fn:focus .fn-note,
  .fn:focus-within .fn-note,
  .fn.is-open .fn-note {
    opacity: 1;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .fn-note { transition: none; }
  }
  @media (max-width: 480px) {
    .fn-note { left: 0; transform: none; }
    .fn-note::after { left: 1rem; transform: none; }
  }
</style>
<script>
  /* 각주 트리거를 탭하면 열리고, 바깥을 탭하면 닫힘 (터치 기기용 보조 동작) */
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const hit = target.closest('.fn');
    document.querySelectorAll('.fn.is-open').forEach((el) => {
      if (el !== hit) el.classList.remove('is-open');
    });
    if (hit && !hit.querySelector('.fn-note')?.contains(target)) {
      hit.classList.toggle('is-open');
    }
  });
</script>
</head>
<body>
<a class="skip" href="#main">본문으로 건너뛰기</a>

<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="/">regx64</a>
    <nav class="nav-links" aria-label="주요 메뉴">
      <a href="/#work">작업</a>
      <a href="/notes/">노트</a>
      <a href="/blog/">블로그</a>
      <a href="https://github.com/regx64">GitHub</a>
    </nav>
  </div>
</header>

<main id="main" class="notes-doc">
  <slot />
</main>

<footer class="foot">
  <div class="foot-inner">
    <p class="foot-tag">트랜지스터부터 컴파일러까지.</p>
    <nav class="foot-links" aria-label="바닥 메뉴">
      <a href="/#work">작업</a>
      <a href="/notes/">노트</a>
      <a href="/blog/">블로그</a>
      <a href="https://github.com/regx64">regx64</a>
      <a href="https://github.com/twopercenz">twopercenz</a>
    </nav>
  </div>
</footer>
<script is:inline src="/site.js" defer></script>
</body>
</html>
