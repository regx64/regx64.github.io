---
import type { Post } from '../lib/blog';
import { categorySlug, formatDate } from '../lib/blog';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---
{posts.length === 0 ? (
  <p class="post-empty">아직 올린 글이 없습니다.</p>
) : (
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="post-link" href={`/blog/${post.slug}/`}>
          {post.data.cover && (
            <img class="post-cover" src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" />
          )}
          <div class="post-body">
            <p class="post-meta">
              <span class="post-cat">{post.data.category}</span>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              {(post.data.audio || post.data.youtube) && <span class="post-media" aria-label="듣거나 볼 것이 있는 글">♪</span>}
            </p>
            <h2 class="post-title">{post.data.title}</h2>
            <p class="post-desc">{post.data.description}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
)}

<style is:global>
  .post-empty { margin: 3rem 0 0; color: var(--muted); }
  .post-list { list-style: none; margin: 2.5rem 0 0; padding: 0; }
  .post-list > li { border-top: 1px solid var(--line); }
  .post-link { display: flex; gap: 1.5rem; align-items: flex-start; padding: 1.5rem 0; text-decoration: none; }
  .post-cover { flex: none; width: 9rem; aspect-ratio: 1; object-fit: cover; border-radius: 1rem; background: var(--bg-alt); }
  .post-body { min-width: 0; }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.75rem; margin: 0 0 0.4rem; font-size: 0.8125rem; color: var(--muted); font-family: var(--mono); }
  .post-cat { color: var(--link); font-family: var(--sans); font-weight: 600; }
  .post-title { margin: 0 0 0.4rem; font-size: 1.3125rem; font-weight: 700; letter-spacing: -0.025em; line-height: 1.35; transition: color 0.2s; }
  .post-link:hover .post-title { color: var(--link); }
  .post-desc { margin: 0; color: var(--muted); }
  @media (max-width: 480px) {
    .post-link { flex-direction: column; gap: 1rem; }
    .post-cover { width: 100%; aspect-ratio: 16 / 9; }
  }
</style>
