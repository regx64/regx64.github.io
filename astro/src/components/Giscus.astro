---
/* 댓글: giscus (GitHub Discussions 기반, Comments 카테고리에 매핑) */
const REPO = 'regx64/regx64.github.io';
const REPO_ID = 'R_kgDOUelrNg';
const CATEGORY = 'Comments';
const CATEGORY_ID = 'DIC_kwDOUelrNs4DF2Ck';
const enabled = REPO_ID !== '' && CATEGORY_ID !== '';
---
{enabled && (
  <section class="giscus-wrap">
    <script
      src="https://giscus.app/client.js"
      data-repo={REPO}
      data-repo-id={REPO_ID}
      data-category={CATEGORY}
      data-category-id={CATEGORY_ID}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang="ko"
      crossorigin="anonymous"
      async
    ></script>
  </section>
)}

<style>
  .giscus-wrap { margin-top: 3rem; }
</style>
