---
import type { Note } from '../lib/notes';
import { tagSlug } from '../lib/notes';

interface Props {
  notes: Note[];
}
const { notes } = Astro.props;
---
<ul class="note-list">
  {notes.map((note) => (
    <li>
      <a class="note-list-link" href={`/notes/${note.slug}/`}>
        <p class="note-list-meta">
          {note.data.date.toISOString().slice(0, 10)}
          {note.data.project && ` · ${note.data.project}`}
          {note.data.series && ` · 시리즈: ${note.data.series}`}
        </p>
        <h2 class="note-list-title">{note.data.title}</h2>
        <p class="note-list-desc">{note.data.description}</p>
      </a>
      {note.data.tags.length > 0 && (
        <p class="tag-row">
          {note.data.tags.map((tag) => (
            <a class="tag" href={`/notes/tags/${tagSlug(tag)}/`}>#{tag}</a>
          ))}
        </p>
      )}
    </li>
  ))}
</ul>

<style is:global>
  .note-list { list-style: none; margin: 2.5rem 0 0; padding: 0; }
  .note-list > li { padding: 1.5rem 0; border-top: 1px solid rgba(0, 0, 0, 0.1); }
  .note-list-link { text-decoration: none; display: block; }
  .note-list-meta {
    margin: 0 0 0.35rem;
    font-size: 0.8125rem;
    color: var(--muted);
    font-family: ui-monospace, Consolas, "D2Coding", monospace;
  }
  .note-list-title { margin: 0 0 0.4rem; font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; }
  .note-list-desc { margin: 0; color: var(--muted); }
  .note-list .tag-row { margin: 0.6rem 0 0; }
</style>
