---
import Layout from '../layouts/Layout.astro';
import NoteList from '../components/NoteList.astro';
import { allNotes, allTags, tagSlug } from '../lib/notes';

const notes = await allNotes();
const tags = await allTags(notes);
---
<Layout
  title="NOTES"
  description="개발 과정, 실험, 실패한 시도, 측정, 구현 결정을 기록하는 엔지니어링 노트."
>
  <h1>NOTES</h1>
  <p class="lede">완성된 프로젝트가 아니라 그 과정을 기록합니다. 실험, 실패한 시도, 측정값, 구현 결정, 디버깅이 대상입니다.</p>

  {tags.length > 0 && (
    <p class="tag-row">
      {tags.map((tag) => (
        <a class="tag" href={`/notes/tags/${tagSlug(tag)}/`}>#{tag}</a>
      ))}
    </p>
  )}

  <NoteList notes={notes} />
</Layout>
