---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout
  title="NOTES"
  description="개발 과정, 실험, 실패한 시도, 측정, 구현 결정을 기록하는 엔지니어링 노트."
>
  <h1>NOTES</h1>
  <p class="lede">완성된 프로젝트가 아니라 그 과정을 기록합니다. 실험, 실패한 시도, 측정값, 구현 결정, 디버깅이 대상입니다.</p>

  <ul style="list-style:none; margin:2.5rem 0 0; padding:0;">
    {notes.map((note) => (
      <li style="padding:1.5rem 0; border-top:1px solid rgba(0,0,0,0.1);">
        <a href={`/notes/${note.slug}/`} style="text-decoration:none;">
          <p style="margin:0 0 0.35rem; font-size:0.8125rem; color:var(--muted); font-family:ui-monospace, Consolas, 'D2Coding', monospace;">
            {note.data.date.toISOString().slice(0, 10)}
            {note.data.project && ` · ${note.data.project}`}
          </p>
          <h2 style="margin:0 0 0.4rem; font-size:1.25rem; font-weight:700; letter-spacing:-0.01em;">{note.data.title}</h2>
          <p style="margin:0; color:var(--muted);">{note.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
</Layout>
